# One-click: repackage Md3 (Release + Debug) and build {{PROJECT_NAME}}.
#
# Usage:
#   .\scripts\auto-pack.ps1
#   .\scripts\auto-pack.ps1 -ReleaseOnly
#   .\scripts\auto-pack.ps1 -DebugOnly
#   .\scripts\auto-pack.ps1 -QtPrefix "D:/Qt/6.10.2/msvc2022_64" -Run

[CmdletBinding()]
param(
    [string]$QtPrefix = "{{QT_PREFIX}}",
    [string]$QmlMd3Root = "",
    [switch]$ReleaseOnly,
    [switch]$DebugOnly,
    [switch]$SkipMd3Pack,
    [switch]$SkipBuild,
    [switch]$Run
)

$ErrorActionPreference = "Stop"

$ProjectRoot = Split-Path $PSScriptRoot -Parent
$TargetName = "{{TARGET_NAME}}"

if (-not $QmlMd3Root) {
    $guess = Join-Path (Split-Path $ProjectRoot -Parent) "QML_MD3"
    if (Test-Path (Join-Path $guess "scripts\package-windows.ps1")) {
        $QmlMd3Root = $guess
    } else {
        $QmlMd3Root = "D:/QML_MD3/QML_MD3"
    }
}

# Defaults from md3-create wizard (override with -ReleaseOnly / -DebugOnly).
$doRelease = {{BUILD_RELEASE_PS}}
$doDebug = {{BUILD_DEBUG_PS}}
if ($ReleaseOnly) { $doRelease = $true; $doDebug = $false }
if ($DebugOnly) { $doRelease = $false; $doDebug = $true }
if (-not $doRelease -and -not $doDebug) {
    throw "Nothing to build: enable Release and/or Debug"
}

function Write-Step([string]$msg) { Write-Host "==> $msg" -ForegroundColor Cyan }

Write-Step "Project: $ProjectRoot"
Write-Step "Qt:      $QtPrefix"
Write-Step "Md3 src: $QmlMd3Root"
Write-Step "Build:   Release=$doRelease Debug=$doDebug"

if (-not $SkipMd3Pack) {
    $packScript = Join-Path $QmlMd3Root "scripts\package-windows.ps1"
    if (-not (Test-Path $packScript)) {
        throw "Md3 pack script not found: $packScript"
    }
    Write-Step "Pack Md3 -> $ProjectRoot\Md3 (Release + Debug runtime)"
    & $packScript -CmakePrefixPath $QtPrefix -SkipSystemInstall -CreateBundleDir $ProjectRoot
    if ($LASTEXITCODE -ne 0) { throw "package-windows.ps1 failed ($LASTEXITCODE)" }
}

$cmake = Get-Command cmake -ErrorAction SilentlyContinue
if (-not $cmake) {
    $cmakeGuess = "D:\Qt\Tools\CMake_64\bin\cmake.exe"
    if (Test-Path $cmakeGuess) { $cmake = $cmakeGuess } else { throw "cmake not found in PATH" }
} else {
    $cmake = $cmake.Source
}

function Build-One([string]$Type) {
    $buildDir = Join-Path $ProjectRoot "build\$Type"
    Write-Step "Configure $Type -> $buildDir"
    & $cmake -S $ProjectRoot -B $buildDir -G Ninja `
        "-DCMAKE_PREFIX_PATH=$QtPrefix" `
        "-DCMAKE_BUILD_TYPE=$Type"
    if ($LASTEXITCODE -ne 0) { throw "cmake configure ($Type) failed" }
    Write-Step "Build $Type"
    & $cmake --build $buildDir
    if ($LASTEXITCODE -ne 0) { throw "cmake build ($Type) failed" }
    Join-Path $buildDir "$TargetName.exe"
}

if (-not $SkipBuild) {
    $built = @()
    if ($doRelease) { $built += Build-One "Release" }
    if ($doDebug) { $built += Build-One "Debug" }
    Write-Step "Built:"
    $built | ForEach-Object { Write-Host "  $_" }
    if ($Run -and $built.Count -gt 0) {
        $runExe = if ($doRelease) { $built[0] } else { $built[-1] }
        Write-Step "Run $runExe"
        Start-Process -FilePath $runExe -WorkingDirectory (Split-Path $runExe -Parent)
    }
}

Write-Step "Done."
