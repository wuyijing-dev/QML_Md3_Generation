cmake_minimum_required(VERSION 3.16)
project({{PROJECT_NAME}} VERSION 0.1.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(Qt6 {{QT_VERSION_MM}} REQUIRED COMPONENTS
    Quick
    QuickControls2
    QuickEffects
    QuickShapesPrivate
)
qt_standard_project_setup(REQUIRES {{QT_VERSION_MM}})

# Md3 component library — override with -DMD3_ROOT=... or CMakePresets
set(MD3_ROOT "{{MD3_PATH}}" CACHE PATH "Path to QML_MD3 repository (or src/Md3)")
if (NOT EXISTS "${MD3_ROOT}/CMakeLists.txt")
    message(FATAL_ERROR "MD3_ROOT invalid (no CMakeLists.txt): ${MD3_ROOT}")
endif()
set(MD3_BUILD_GALLERY OFF CACHE BOOL "Skip Gallery demo" FORCE)
add_subdirectory("${MD3_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}/md3")

qt_add_executable({{TARGET_NAME}} main.cpp)

qt_add_qml_module({{TARGET_NAME}}
    URI {{QML_URI}}
    VERSION 1.0
    QML_FILES
        Main.qml
{{EXTRA_QML_FILES}}
)

set_target_properties({{TARGET_NAME}} PROPERTIES
    WIN32_EXECUTABLE TRUE
    MACOSX_BUNDLE TRUE
)

target_link_libraries({{TARGET_NAME}} PRIVATE
    Qt6::Quick
    Qt6::QuickControls2
    Md3
)
if (TARGET Md3plugin)
    target_link_libraries({{TARGET_NAME}} PRIVATE Md3plugin)
endif()
