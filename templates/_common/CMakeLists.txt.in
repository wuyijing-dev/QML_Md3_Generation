cmake_minimum_required(VERSION 3.16)
project({{PROJECT_NAME}} VERSION 0.1.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(Qt6 {{QT_VERSION_MM}} REQUIRED COMPONENTS
    Quick
    QuickControls2
    QuickEffects
    QuickShapesPrivate
    Widgets
)
qt_standard_project_setup(REQUIRES {{QT_VERSION_MM}})

# ---- Md3: packaged library in the SAME directory as this CMakeLists.txt ----
set(MD3_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Md3" CACHE PATH
    "Md3 package next to this CMakeLists.txt")
if (EXISTS "${MD3_DIR}/lib/cmake/Md3/Md3Config.cmake")
    list(APPEND CMAKE_PREFIX_PATH "${MD3_DIR}")
    find_package(Md3 REQUIRED CONFIG)
elseif (EXISTS "${MD3_DIR}/Md3Prebuilt.cmake")
    include("${MD3_DIR}/Md3Prebuilt.cmake")
else()
    message(FATAL_ERROR
        "Md3 package not found at:\n  ${MD3_DIR}\n"
        "Place the packaged library folder named exactly \"Md3\" "
        "beside this CMakeLists.txt (same directory).")
endif()

qt_add_executable({{TARGET_NAME}} main.cpp)

qt_add_qml_module({{TARGET_NAME}}
    URI {{QML_URI}}
    VERSION 1.0
    NO_CACHEGEN
    QML_FILES
        Main.qml
{{EXTRA_QML_FILES}}
)

set_target_properties({{TARGET_NAME}} PROPERTIES
    WIN32_EXECUTABLE TRUE
    MACOSX_BUNDLE TRUE
)

target_link_libraries({{TARGET_NAME}} PRIVATE
    Qt6::Quick
    Qt6::QuickControls2
    Qt6::Widgets
)

if (Md3_SHARED)
    if (TARGET Md3::Md3)
        target_link_libraries({{TARGET_NAME}} PRIVATE Md3::Md3)
    endif()
    if (TARGET Md3plugin)
        target_link_libraries({{TARGET_NAME}} PRIVATE Md3plugin)
    endif()
    target_compile_definitions({{TARGET_NAME}} PRIVATE MD3_SHARED)
else()
    if (TARGET Md3::QmlPlugin)
        target_link_libraries({{TARGET_NAME}} PRIVATE Md3::QmlPlugin)
    else()
        if (TARGET Md3plugin)
            target_link_libraries({{TARGET_NAME}} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,Md3plugin>")
        endif()
        if (TARGET Md3plugin_init)
            target_link_libraries({{TARGET_NAME}} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,Md3plugin_init>")
        endif()
        if (TARGET Md3::Md3)
            target_link_libraries({{TARGET_NAME}} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,Md3::Md3>")
        elseif (TARGET Md3)
            target_link_libraries({{TARGET_NAME}} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,Md3>")
        endif()
    endif()
endif()

qt_import_qml_plugins({{TARGET_NAME}})

if (EXISTS "${MD3_DIR}/lib/cmake/Md3/Md3DeployShared.cmake")
    include("${MD3_DIR}/lib/cmake/Md3/Md3DeployShared.cmake")
endif()
if (COMMAND md3_deploy_shared_runtime)
    md3_deploy_shared_runtime({{TARGET_NAME}} "${MD3_DIR}")
elseif (Md3_SHARED AND WIN32 AND EXISTS "${MD3_DIR}/bin/Md3.dll")
    if (CMAKE_BUILD_TYPE STREQUAL "Debug")
        message(WARNING
            "Md3: Debug build with Release-only package — use Release kit or repackage Md3.")
    endif()
    add_custom_command(TARGET {{TARGET_NAME}} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${MD3_DIR}/bin/Md3.dll" "$<TARGET_FILE_DIR:{{TARGET_NAME}}>"
        COMMAND ${CMAKE_COMMAND} -E copy_directory
            "${MD3_DIR}/lib/qml" "$<TARGET_FILE_DIR:{{TARGET_NAME}}>/qml"
        COMMENT "Deploy shared Md3 beside {{TARGET_NAME}}"
    )
endif()
